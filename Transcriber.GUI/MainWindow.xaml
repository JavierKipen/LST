<Window x:Class="Transcriber.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transcriber.GUI"
        mc:Ignorable="d"
        Title="Audio Transcriber" Height="550" Width="600"
        MinHeight="550" MinWidth="600"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- File Selection Section -->
        <Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Background="White" Padding="15">
            <StackPanel>
                <TextBlock Text="Audio File" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="FilePathTextBox" 
                             Grid.Column="0"
                             IsReadOnly="True" 
                             VerticalContentAlignment="Center"
                             Padding="10,8"
                             Background="#F9F9F9"
                             BorderBrush="#DDDDDD"
                             Text="No file selected"/>
                    
                    <Button x:Name="BrowseButton" 
                            Grid.Column="2"
                            Content="Browse..." 
                            Click="BrowseButton_Click"
                            Padding="20,8"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Model Accuracy Section -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="5" Background="White" Padding="15">
            <StackPanel>
                <TextBlock Text="Model Accuracy" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <ComboBox x:Name="AccuracyComboBox" 
                          SelectedIndex="1"
                          Padding="10,8"
                          FontSize="13">
                    <ComboBoxItem Content="Very Low (Fastest)" Tag="VeryLow"/>
                    <ComboBoxItem Content="Low" Tag="Low"/>
                    <ComboBoxItem Content="Medium" Tag="Medium"/>
                    <ComboBoxItem Content="Good" Tag="Good"/>
                    <ComboBoxItem Content="Very Good (Slowest)" Tag="VeryGood"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Transcribe Button -->
        <Button x:Name="TranscribeButton" 
                Grid.Row="4"
                Content="Start Transcription" 
                Click="TranscribeButton_Click"
                IsEnabled="False"
                Padding="0,15"
                FontSize="16"
                FontWeight="Bold"
                Background="#2196F3"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"/>

        <!-- Progress Section (Hidden by default) -->
        <Border x:Name="ProgressPanel" 
                Grid.Row="5" 
                BorderBrush="#CCCCCC" 
                BorderThickness="1" 
                CornerRadius="5" 
                Background="White" 
                Padding="15"
                Margin="0,20,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ProgressStatusText" 
                           Text="Processing..." 
                           FontWeight="Bold" 
                           FontSize="14" 
                           Margin="0,0,0,10"/>
                <ProgressBar x:Name="TranscriptionProgressBar" 
                             Height="25" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0"/>
                <TextBlock x:Name="ProgressPercentageText" 
                           Text="0%" 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="#666666"/>
                <TextBlock x:Name="ETAText" 
                           Text="Estimating time remaining..." 
                           HorizontalAlignment="Center" 
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="#888888"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
